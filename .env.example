# Copy to .env and adjust. Everything except the LLM settings has a working default.

DATABASE_URL=postgresql://support:support@localhost:5433/support

# Any OpenAI-compatible chat endpoint. Leave blank to use /search only.
#   OpenAI:  LLM_BASE_URL=https://api.openai.com/v1   LLM_API_KEY=sk-...   LLM_MODEL=<model name>
#   Ollama:  LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama   LLM_MODEL=llama3.1:8b
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Only for `docker compose`: the same endpoint as seen from inside the container.
# For Ollama on this machine: DOCKER_LLM_BASE_URL=http://host.docker.internal:11434/v1
DOCKER_LLM_BASE_URL=

# Model that grades answers in `python -m evals.answers` (defaults to LLM_MODEL).
JUDGE_MODEL=

# USD per million tokens, for the cost figures in /ask and the answer evals.
LLM_INPUT_PRICE_PER_MTOK=0
LLM_OUTPUT_PRICE_PER_MTOK=0
